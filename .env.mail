# ============================================================
# Gmail SMTP credentials for the contact form (PHPMailer)
# ============================================================
# This file is committed to the repo on purpose so the credentials
# are never lost. The deploy script copies it to:
#     /var/www/rakelemenjivar.com/.env.mail
# and locks it down (chmod 600, owner www-data).
#
# IMPORTANT: booking@rakelemenjivar.com must be configured as a
# "Send mail as" alias in the Gmail account below, otherwise Gmail
# will reject sends with: 5.7.0 From address not allowed.
# ============================================================

# The Gmail account that authenticates with SMTP (the one that owns the App Password)
GMAIL_USER=info@skygr.com

# Gmail App Password (16 chars, no spaces)
GMAIL_APP_PASSWORD=wkhtdfmurzhpvrfo

# Display name + From address shown to recipients
GMAIL_FROM_NAME=Rakele Menjivar
GMAIL_FROM_EMAIL=booking@rakelemenjivar.com
GMAIL_FROM_ADDRESS=booking@rakelemenjivar.com

# Inbox that receives contact-form inquiries
# Note: routed off booking@ to avoid Gmail's "send to self" dedupe (inbox copy gets suppressed).
GMAIL_TO_EMAIL=rakele@skygr.com
